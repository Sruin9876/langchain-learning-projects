# Gemini API (required to generate summaries/email drafts)
GOOGLE_API_KEY=put_your_google_ai_studio_key_here
GEMINI_MODEL=gemini-3.5-flash-lite

# SMTP email sending (optional; drafts can be downloaded without these settings)
# For Gmail, use smtp.gmail.com:587 and an App Password, not your normal account password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SENDER_EMAIL=
